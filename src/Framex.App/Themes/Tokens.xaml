<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Tokens padrão (tema Cyber Neon). O ThemeService substitui estas chaves em tempo de execução;
        toda a interface as consome via DynamicResource.
    -->
    <Color x:Key="C.Background">#070B14</Color>
    <Color x:Key="C.Primary">#00E5FF</Color>
    <Color x:Key="C.Accent">#A259FF</Color>
    <Color x:Key="C.Accent2">#FF3D9A</Color>

    <SolidColorBrush x:Key="B.Background" Color="#070B14" />
    <SolidColorBrush x:Key="B.BackgroundAlt" Color="#0B1220" />
    <SolidColorBrush x:Key="B.Surface" Color="#0F1626" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="#151E33" />
    <SolidColorBrush x:Key="B.SurfaceHigh" Color="#1B2742" />
    <SolidColorBrush x:Key="B.Border" Color="#22304D" />
    <SolidColorBrush x:Key="B.Primary" Color="#00E5FF" />
    <SolidColorBrush x:Key="B.Secondary" Color="#19F5B5" />
    <SolidColorBrush x:Key="B.Accent" Color="#A259FF" />
    <SolidColorBrush x:Key="B.Accent2" Color="#FF3D9A" />
    <SolidColorBrush x:Key="B.Text" Color="#E7EEFC" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#8A9BBD" />
    <SolidColorBrush x:Key="B.OnPrimary" Color="#04121A" />
    <SolidColorBrush x:Key="B.Success" Color="#2EE58A" />
    <SolidColorBrush x:Key="B.Warning" Color="#FFB020" />
    <SolidColorBrush x:Key="B.Error" Color="#FF4D5E" />
    <SolidColorBrush x:Key="B.PrimarySoft" Color="#1F00E5FF" />
    <SolidColorBrush x:Key="B.PrimaryHover" Color="#3300E5FF" />
    <SolidColorBrush x:Key="B.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.Pressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="B.Chart0" Color="#00E5FF" />
    <SolidColorBrush x:Key="B.Chart1" Color="#19F5B5" />
    <SolidColorBrush x:Key="B.Chart2" Color="#A259FF" />
    <SolidColorBrush x:Key="B.Chart3" Color="#FF3D9A" />
    <SolidColorBrush x:Key="B.Chart4" Color="#FFB020" />
    <SolidColorBrush x:Key="B.Chart5" Color="#4D7CFF" />

    <LinearGradientBrush x:Key="B.HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#00E5FF" />
        <GradientStop Offset="1" Color="#A259FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.SurfaceGradient" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#151E33" />
        <GradientStop Offset="1" Color="#0F1626" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="B.Backdrop" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.9" RadiusY="0.7">
        <GradientStop Offset="0" Color="#1A00E5FF" />
        <GradientStop Offset="1" Color="#00000000" />
    </RadialGradientBrush>

    <CornerRadius x:Key="R.Corner">12</CornerRadius>
    <CornerRadius x:Key="R.CornerSmall">8</CornerRadius>
    <CornerRadius x:Key="R.Pill">99</CornerRadius>
    <sys:Double x:Key="D.Corner">12</sys:Double>
    <Thickness x:Key="T.Border">1</Thickness>
    <Thickness x:Key="T.Card">18</Thickness>
    <Thickness x:Key="T.CardCompact">12</Thickness>
    <Thickness x:Key="T.Gap">0,0,14,14</Thickness>

    <FontFamily x:Key="F.Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="S.Caption">11</sys:Double>
    <sys:Double x:Key="S.Body">13</sys:Double>
    <sys:Double x:Key="S.Subtitle">15</sys:Double>
    <sys:Double x:Key="S.Title">22</sys:Double>
    <sys:Double x:Key="S.Hero">34</sys:Double>
    <sys:Double x:Key="S.Display">56</sys:Double>

    <sys:Double x:Key="O.Surface">1</sys:Double>
    <sys:Double x:Key="O.Glow">0.55</sys:Double>
</ResourceDictionary>
