<UserControl x:Class="Framex.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Framex.App.ViewModels"
             xmlns:fx="clr-namespace:Framex.App.Controls"
             xmlns:gd="clr-namespace:Framex.Core.Domain;assembly=Framex.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GamesViewModel}" d:DesignWidth="1100" d:DesignHeight="800">
    <UserControl.Resources>
        <fx:BoolToVisibilityConverter x:Key="Vis" />
        <fx:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />

        <Style x:Key="EmptyWhenZero" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <DataTemplate x:Key="GameCard" DataType="{x:Type vm:GameItemViewModel}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Cabeçalho -->
                    <DockPanel DockPanel.Dock="Top">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource B.HeroGradient}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource F.Display}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource B.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ToolTip="Mais ações" VerticalAlignment="Top" Click="OnMoreClick"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.ChevronDown}" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Renomear…" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Associar outro executável…" Command="{Binding PlacementTarget.Tag.AddExecutableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Ver relatórios" Command="{Binding PlacementTarget.Tag.ShowReportsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Restaurar monitoramento" Command="{Binding PlacementTarget.Tag.RestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                              Visibility="{Binding IsRemoved, Converter={StaticResource Vis}}" />
                                    <MenuItem Header="Remover da biblioteca" Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                                              Visibility="{Binding IsRemoved, Converter={StaticResource NotVis}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Executables}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Executables}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Estatísticas -->
                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Sessões" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding SessionsText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Tempo total" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel ToolTip="Média harmônica ponderada pelo número de quadros das sessões com captura">
                            <TextBlock Text="FPS médio" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding AverageFpsText}" FontWeight="SemiBold" Foreground="{DynamicResource B.Primary}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" Style="{StaticResource Text.Caption}">
                        <Run Text="Última sessão:" /> <Run Text="{Binding LastText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Source, Mode=OneWay}" />
                    </TextBlock>

                    <Rectangle DockPanel.Dock="Top" Style="{StaticResource Divider}" Margin="0,14" />

                    <!-- Perfil -->
                    <StackPanel>
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="{Binding IsRemoved, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource B.Warning}" FontSize="12" />
                        </Border>
                        <DockPanel Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CaptureFrames}" />
                            <TextBlock Text="Capturar FPS e frametime" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding ShowOverlay}" />
                            <TextBlock Text="Exibir overlay" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AlertsEnabled}" />
                            <TextBlock Text="Alertas" VerticalAlignment="Center" />
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding DataContext.LayoutChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding OverlayLayoutId}" ToolTip="Layout do overlay usado neste jogo" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="Recarregar">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Refresh}" Width="15" Height="15" />
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding AddFromFileCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Folder}" Width="15" Height="15" />
                                <TextBlock Text="Adicionar por arquivo" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenPickerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Plus}" Width="15" Height="15" />
                                <TextBlock Text="Adicionar em execução" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Jogos" Style="{StaticResource Text.Hero}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Pendentes -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,18" BorderBrush="{DynamicResource B.Warning}"
                        Visibility="{Binding Pending.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Warning}" Stroke="{DynamicResource B.Warning}" />
                            <TextBlock Text="Jogos detectados aguardando confirmação" Style="{StaticResource Text.Subtitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="A detecção automática é uma estimativa (pasta de instalação, launcher, uso de GPU, tela cheia). Confirme apenas o que realmente é um jogo."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Pending}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8" Padding="14,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Não é um jogo" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.NotAGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Content="Confirmar" Style="{StaticResource Button.Primary}"
                                                        Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Text.Caption}">
                                                    <Run Text="{Binding Executables, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Source, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Filtros -->
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowRemoved}" />
                        <TextBlock Text="Mostrar removidos" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Width="360" HorizontalAlignment="Left">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0" ToolTip="Buscar por nome ou executável" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Search}" Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                              Stroke="{DynamicResource B.TextMuted}" />
                    </Grid>
                </DockPanel>

                <TextBlock Text="Nenhum jogo na biblioteca. Abra um jogo para que seja detectado, ou adicione manualmente."
                           Style="{StaticResource Text.Muted}" Margin="0,20"
                           Visibility="{Binding Games.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCard}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><fx:DashboardPanel MinColumnWidth="320" Spacing="16" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Ignorados -->
                <StackPanel Margin="0,26,0,0" Visibility="{Binding Ignored.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}}">
                    <TextBlock Text="Executáveis ignorados" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="Não são considerados pela detecção automática." Style="{StaticResource Text.Muted}" Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding Ignored}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="12,4,4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                                        <Button Style="{StaticResource Button.Icon}" Width="24" Height="24" Margin="6,0,0,0" ToolTip="Voltar a considerar na detecção"
                                                Command="{Binding DataContext.UnignoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" Width="12" Height="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Seletor de processos em execução -->
        <Grid Visibility="{Binding PickerOpen, Converter={StaticResource Vis}}">
            <Border Background="{DynamicResource B.Backdrop}" MouseLeftButtonDown="OnBackdropClick" />
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource B.SurfaceAlt}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding ClosePickerCommand}" ToolTip="Fechar">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Adicionar jogo em execução" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="Processos com janela visível que ainda não estão na biblioteca." Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="Nenhum processo elegível encontrado." Style="{StaticResource Text.Muted}" Margin="0,10"
                                   Visibility="{Binding RunningProcesses.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                        <ListBox ItemsSource="{Binding RunningProcesses}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type gd:ProcessInfo}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Adicionar" Style="{StaticResource Button.Primary}" Padding="12,5"
                                                Command="{Binding DataContext.AddRunningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding WindowTitle, TargetNullValue='(sem título)'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding ExecutableName, Mode=OneWay}" /> <Run Text="· PID" /> <Run Text="{Binding ProcessId, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
