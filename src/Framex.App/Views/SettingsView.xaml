<UserControl x:Class="Framex.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Framex.App.ViewModels"
             xmlns:fx="clr-namespace:Framex.App.Controls"
             xmlns:alerts="clr-namespace:Framex.Core.Alerts;assembly=Framex.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}" d:DesignWidth="1100" d:DesignHeight="900">
    <UserControl.Resources>
        <fx:EnumEqualsConverter x:Key="EnumEq" />
        <fx:BoolToVisibilityConverter x:Key="Vis" />
        <fx:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
        <fx:NullToVisibilityConverter x:Key="NullVis" />

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,8,24,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação das seções -->
        <StackPanel>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,0,18">
                <TextBlock Text="Configurações" Style="{StaticResource Text.Hero}" />
            </Viewbox>
            <RadioButton Style="{StaticResource Segment}" HorizontalContentAlignment="Left" GroupName="SettingsNav" Content="Geral" IsChecked="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=General}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="SettingsNav" Content="Captura e jogos" IsChecked="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Capture}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="SettingsNav" Content="Alertas" IsChecked="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Alerts}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="SettingsNav" Content="Atalhos" IsChecked="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Hotkeys}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="SettingsNav" Content="Relatórios e dados" IsChecked="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Data}" />
            <TextBlock Text="As alterações são salvas automaticamente." Style="{StaticResource Text.Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- ============================== GERAL ============================== -->
                <StackPanel Visibility="{Binding Section, Converter={x:Static fx:EnumToVisibilityConverter.Instance}, ConverterParameter=General}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Inicialização e janela" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Cria uma entrada visível em HKCU\…\Run (aparece no Gerenciador de Tarefas › Inicializar). Desativar remove a entrada." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Iniciar minimizado na bandeja" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Vale para a inicialização com o Windows. Requer o ícone na bandeja." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding ShowTrayIcon}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Ícone na bandeja do sistema" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Sem o ícone, fechar a janela sempre encerra o FRAMEX." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding CloseChoice}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Ao fechar a janela" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Minimizado, o monitoramento e a gravação de sessões continuam." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Perfil de desempenho" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Text="Define a frequência de leitura dos sensores e de atualização da interface e do overlay. O impacto real do FRAMEX pode ser medido com o plano descrito em docs/BENCHMARK.md." Style="{StaticResource RowHint}" Margin="0,2,0,10" />
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="Profiles" Margin="0,4" Content="{Binding Label}" Foreground="{DynamicResource B.Text}" Click="OnProfileClick" Tag="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{x:Static fx:ReferenceEqualsConverter.Instance}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.Profile" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Overlay" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding OverlayEnabled}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Overlay ativado" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Janela independente, sempre no topo e transparente a cliques; não injeta código no jogo." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding OverlayOnlyDuringGames}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Mostrar somente durante jogos" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Desativado, o overlay fica visível sempre que ativado (útil para testes)." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================== CAPTURA ============================== -->
                <StackPanel Visibility="{Binding Section, Converter={x:Static fx:EnumToVisibilityConverter.Instance}, ConverterParameter=Capture}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCaptureCommand}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Refresh}" Width="14" Height="14" />
                                        <TextBlock Text="Verificar" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Captura de FPS e frametime (PresentMon)" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding CaptureStatus}" FontWeight="SemiBold" Foreground="{DynamicResource B.Primary}" />
                                    <TextBlock Text="{Binding CaptureDetail}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Muted}">
                                O FRAMEX usa o PresentMon (Intel, licença MIT) para ler eventos de apresentação de quadros via ETW, sem injetar código no jogo.
                                O Setup.exe já inclui o PresentMon e um serviço do Windows que faz a captura sem você precisar configurar nada nem executar como administrador.
                                Esta tela serve para quem está rodando o FRAMEX sem o instalador: coloque o PresentMon (versão console) na pasta de ferramentas ou indique o caminho abaixo.
                            </TextBlock>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenPresentMonPageCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Link}" Width="14" Height="14" />
                                        <TextBlock Text="Abrir página oficial do PresentMon" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenToolsFolderCommand}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Folder}" Width="14" Height="14" />
                                        <TextBlock Text="Abrir pasta de ferramentas" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding RestartElevatedCommand}" Margin="0,0,8,8" Visibility="{Binding IsElevated, Converter={StaticResource NotVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Shield}" Width="14" Height="14" />
                                        <TextBlock Text="Reiniciar como administrador" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                <Run Text="Pastas pesquisadas:" /> <Run Text="{Binding ToolsFolder, Mode=OneWay}" /> <Run Text="e" /> <Run Text="{Binding AppToolsFolder, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding DetectedPresentMon, Converter={StaticResource NullVis}}">
                                <Run Text="Executável em uso:" /> <Run Text="{Binding DetectedPresentMon, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="Caminho manual (opcional)" Style="{StaticResource RowTitle}" Margin="0,16,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Limpar" Style="{StaticResource Button.Ghost}" Command="{Binding ClearPresentMonCommand}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Procurar…" Style="{StaticResource Button.Ghost}" Command="{Binding BrowsePresentMonCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding PresentMonPath, UpdateSourceTrigger=LostFocus}" ToolTip="Caminho completo para PresentMon*.exe" />
                            </DockPanel>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0" Margin="0,8,0,0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CaptureFrames}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Capturar quadros durante sessões" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Pode ser desativado por jogo na tela Jogos." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Detecção de jogos" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AutoDetectStoreGames}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Detectar jogos automaticamente" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Procura processos com janela visível em pastas de bibliotecas (Steam, Epic, GOG, Ubisoft, EA, Riot, Xbox). Jogos detectados ficam pendentes até você confirmar." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding RecordUnconfirmedGames}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Gravar sessões de jogos não confirmados" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Os relatórios ficam marcados como “não confirmado”." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Width="180" Minimum="0" Maximum="120" Value="{Binding ExitGraceSeconds}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                        <TextBlock Text="{Binding ExitGraceSeconds, StringFormat='{}{0} s'}" Width="44" TextAlignment="Right" FontFamily="{DynamicResource F.Mono}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tolerância para reinício do jogo" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Se o jogo reabrir dentro deste tempo (ex.: launcher → jogo), a mesma sessão continua." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Width="180" Minimum="0" Maximum="600" Value="{Binding MinSessionSeconds}" TickFrequency="10" IsSnapToTickEnabled="True" />
                                        <TextBlock Text="{Binding MinSessionSeconds, StringFormat='{}{0} s'}" Width="44" TextAlignment="Right" FontFamily="{DynamicResource F.Mono}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Duração mínima de uma sessão" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Sessões mais curtas são descartadas (aberturas acidentais)." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================== ALERTAS ============================== -->
                <StackPanel Visibility="{Binding Section, Converter={x:Static fx:EnumToVisibilityConverter.Instance}, ConverterParameter=Alerts}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AlertsEnabled}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Alertas ativados" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Os limites são definidos por você. O FRAMEX não define limites “seguros” universais: consulte as especificações do fabricante do seu hardware." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Width="260" ItemsSource="{Binding Channels}" SelectedItem="{Binding ChannelChoice}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Onde avisar" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Todos os alertas disparados também ficam registrados no relatório da sessão." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Restaurar regras iniciais" Style="{StaticResource Button.Ghost}" Command="{Binding RestoreDefaultRulesCommand}" />
                                <TextBlock Text="Regras" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AlertRuleRow}">
                                        <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,10" Padding="14,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ToolTip="Remover regra" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" Width="14" Height="14" />
                                                    </Button>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Ativa/desativa a regra" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="80" Margin="0,0,12,0" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding SubjectText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,8" />
                                                <WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Visibility="{Binding HasThreshold, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="Quando estiver" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                                                        <ComboBox Width="110" SelectedIndex="{Binding Below, Converter={x:Static fx:BoolToIndexConverter.Instance}}">
                                                            <ComboBoxItem Content="acima de" />
                                                            <ComboBoxItem Content="abaixo de" />
                                                        </ComboBox>
                                                        <TextBox Width="80" Margin="8,0,6,0" Text="{Binding Threshold, UpdateSourceTrigger=LostFocus, StringFormat='0.##'}" TextAlignment="Right" />
                                                        <TextBlock Text="{Binding UnitText}" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                                        <TextBlock Text="por pelo menos" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                                                        <TextBox Width="60" Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                        <TextBlock Text="s" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                                        <TextBlock Text="intervalo entre avisos" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                                                        <TextBox Width="60" Text="{Binding CooldownMinutes, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                        <TextBlock Text="min" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="jogo" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                                                        <ComboBox Width="190" ItemsSource="{Binding DataContext.GameChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GameId}" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding AddRuleCommand}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Plus}" Width="14" Height="14" />
                                        <TextBlock Text="Adicionar regra" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <ComboBox ItemsSource="{Binding AlertTemplates}" SelectedItem="{Binding TemplateToAdd}" DisplayMemberPath="Label" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Alertas recentes" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                            <TextBlock Text="Nenhum alerta registrado." Style="{StaticResource Text.Muted}"
                                       Visibility="{Binding AlertHistory.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding AlertHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type alerts:AlertRecord}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp, Converter={x:Static fx:LocalTimeConverter.Instance}}" Style="{StaticResource Text.Muted}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" TextWrapping="Wrap">
                                                <Run Text="{Binding Message, Mode=OneWay}" /> <Run Text="{Binding GameName, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource B.TextMuted}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================== ATALHOS ============================== -->
                <StackPanel Visibility="{Binding Section, Converter={x:Static fx:EnumToVisibilityConverter.Instance}, ConverterParameter=Hotkeys}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Restaurar padrões" Style="{StaticResource Button.Ghost}" Command="{Binding ResetHotkeysCommand}" />
                                <StackPanel>
                                    <TextBlock Text="Atalhos globais" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="Clique no campo e pressione a combinação (use Ctrl, Alt ou Shift). Backspace limpa o atalho." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <fx:HotkeyBox DockPanel.Dock="Right" Width="200" Gesture="{Binding HotkeyOverlay, Mode=TwoWay}" />
                                    <TextBlock Text="Mostrar/ocultar overlay" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <fx:HotkeyBox DockPanel.Dock="Right" Width="200" Gesture="{Binding HotkeyWindow, Mode=TwoWay}" />
                                    <TextBlock Text="Mostrar/ocultar a janela do FRAMEX" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <fx:HotkeyBox DockPanel.Dock="Right" Width="200" Gesture="{Binding HotkeyPause, Mode=TwoWay}" />
                                    <TextBlock Text="Pausar/retomar gravação da sessão" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <fx:HotkeyBox DockPanel.Dock="Right" Width="200" Gesture="{Binding HotkeyEdit, Mode=TwoWay}" />
                                    <TextBlock Text="Arrastar/posicionar o overlay" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding HotkeyFailures}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Warning}" Width="14" Height="14" Stroke="{DynamicResource B.Warning}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource B.Warning}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================== DADOS ============================== -->
                <StackPanel Visibility="{Binding Section, Converter={x:Static fx:EnumToVisibilityConverter.Instance}, ConverterParameter=Data}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Relatórios" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AutoOpenReport}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Abrir o relatório ao final da sessão" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Somente se a janela do FRAMEX estiver aberta (nunca rouba o foco do jogo)." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding NotifySessionEnd}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Notificar ao final da sessão" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Notificação local do Windows com o resumo. Nada é enviado para fora do computador." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="Pasta padrão de exportação" Style="{StaticResource RowTitle}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource Button.Ghost}" Command="{Binding BrowseExportFolderCommand}" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding ExportFolder, Mode=OneWay}" IsReadOnly="True" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Armazenamento local" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox Width="200" SelectedValuePath="Tag" SelectedValue="{Binding RetentionDays}">
                                            <ComboBoxItem Content="Manter para sempre" Tag="{x:Static fx:RetentionChoices.Forever}" />
                                            <ComboBoxItem Content="30 dias" Tag="{x:Static fx:RetentionChoices.Days30}" />
                                            <ComboBoxItem Content="90 dias" Tag="{x:Static fx:RetentionChoices.Days90}" />
                                            <ComboBoxItem Content="180 dias" Tag="{x:Static fx:RetentionChoices.Days180}" />
                                            <ComboBoxItem Content="1 ano" Tag="{x:Static fx:RetentionChoices.Days365}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Retenção das amostras detalhadas" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Após o prazo, as amostras e os gráficos de sessões antigas são apagados; o resumo e as estatísticas permanecem." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DatabaseSize}" FontFamily="{DynamicResource F.Mono}" VerticalAlignment="Center" />
                                    <TextBlock Text="Tamanho do banco de dados" Style="{StaticResource RowTitle}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                        <Run Text="Dados:" /> <Run Text="{Binding DataFolder, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Logs:" /> <Run Text="{Binding LogsFolder, Mode=OneWay}" />
                                    </TextBlock>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Abrir pasta de dados" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                        <Button Content="Abrir pasta de logs" Style="{StaticResource Button.Ghost}" Command="{Binding OpenLogsFolderCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Shield}" Stroke="{DynamicResource B.Secondary}" />
                                <TextBlock Text="Privacidade" Style="{StaticResource Text.Subtitle}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Muted}"
                                       Text="O FRAMEX funciona totalmente offline: não exige conta, não tem telemetria e não envia relatórios. Tudo fica nas pastas acima. Arquivos exportados não incluem caminhos de pastas pessoais nem o nome de usuário do Windows." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
