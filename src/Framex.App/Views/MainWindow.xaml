<Window x:Class="Framex.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Framex.App.ViewModels"
        xmlns:views="clr-namespace:Framex.App.Views"
        xmlns:fx="clr-namespace:Framex.App.Controls"
        xmlns:svc="clr-namespace:Framex.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="FRAMEX" Width="1360" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Background}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Body}" FontSize="{DynamicResource S.Body}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Framex;component/Assets/framex.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <fx:EnumEqualsConverter x:Key="EnumEq" />
        <fx:BoolToVisibilityConverter x:Key="Vis" />
        <fx:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupScoreViewModel}"><views:SetupScoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportDetailViewModel}"><views:ReportDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}"><views:CompareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomizationViewModel}"><views:CustomizationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>

        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fundo com brilho sutil -->
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource B.Backdrop}" IsHitTestVisible="False" />

        <!-- ====================== Barra lateral ====================== -->
        <Border Grid.Column="0" Background="{DynamicResource B.BackgroundAlt}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,0,26">
                    <Image Source="pack://application:,,,/Assets/framex-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FRAMEX" FontFamily="{DynamicResource F.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource B.HeroGradient}" />
                        <TextBlock Text="desempenho em jogos" Style="{StaticResource Text.Caption}" Margin="1,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Command="{Binding ToggleOverlayCommand}" Margin="0,0,0,6"
                            ToolTip="Mostrar ou ocultar o HUD sobre os jogos">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Overlay}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Mostrar overlay" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverlayVisible}" Value="True">
                                                <Setter Property="Text" Value="Ocultar overlay" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Command="{Binding TogglePauseCommand}"
                            ToolTip="Pausa a gravação de sessões e a captura de quadros">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PauseIcon">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Data" Value="{StaticResource I.Pause}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecordingPaused}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource I.Play}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pausar gravação" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecordingPaused}" Value="True">
                                                <Setter Property="Text" Value="Retomar gravação" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" Margin="14,14,0,0" />
                </StackPanel>

                <StackPanel Margin="8,0">
                    <TextBlock Text="MONITORAMENTO" Style="{StaticResource Text.Section}" Margin="24,0,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Dashboard}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Dashboard}" /><TextBlock Text="Painel" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Games}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Games}" /><TextBlock Text="Jogos" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Hardware}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Hardware}" /><TextBlock Text="Hardware" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=SetupScore}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Gauge}" /><TextBlock Text="Nota do Setup" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Reports}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Reports}" /><TextBlock Text="Relatórios" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <TextBlock Text="APLICATIVO" Style="{StaticResource Text.Section}" Margin="24,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Customization}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Palette}" /><TextBlock Text="Personalização" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Settings}" /><TextBlock Text="Configurações" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Info}" /><TextBlock Text="Sobre" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====================== Conteúdo ====================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior: estado + botões da janela -->
            <DockPanel Grid.Row="0" Margin="24,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Chrome}" Click="OnMinimize" ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Minimize}" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Chrome}" Click="OnMaximize" ToolTip="Maximizar / restaurar" AutomationProperties.Name="Maximizar">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Maximize}" Width="11" Height="11" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Button.Chrome}" Click="OnClose" ToolTip="Fechar" AutomationProperties.Name="Fechar">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" Width="12" Height="12" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusChip}" ToolTip="Jogo monitorado no momento">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource B.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource B.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GameStatus}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusChip}" ToolTip="{Binding CaptureDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource I.Pulse}" Width="14" Height="14" Margin="0,0,8,0">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Stroke" Value="{DynamicResource B.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CaptureTone}" Value="Good"><Setter Property="Stroke" Value="{DynamicResource B.Success}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding CaptureTone}" Value="Info"><Setter Property="Stroke" Value="{DynamicResource B.Primary}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding CaptureTone}" Value="Warn"><Setter Property="Stroke" Value="{DynamicResource B.Warning}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding CaptureStatus}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusChip}" Visibility="{Binding GameActive, Converter={StaticResource Vis}}" ToolTip="FPS ao vivo (janela de 1 s)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FpsBadge}" FontFamily="{DynamicResource F.Display}" FontWeight="SemiBold" Foreground="{DynamicResource B.Primary}" />
                            <TextBlock Text=" FPS" Foreground="{DynamicResource B.TextMuted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusChip}" Visibility="{Binding RecordingPaused, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource B.Warning}">
                        <TextBlock Text="Gravação pausada" Foreground="{DynamicResource B.Warning}" />
                    </Border>
                    <Border Style="{StaticResource StatusChip}" Visibility="{Binding IsElevated, Converter={StaticResource NotVis}}" ToolTip="O serviço do FRAMEX não está em execução: a captura de FPS e os sensores de temperatura, clock e consumo da CPU ficam indisponíveis. Reinstale pelo Setup.exe ou veja Configurações › Captura.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Shield}" Width="13" Height="13" Margin="0,0,6,0" Stroke="{DynamicResource B.TextMuted}" />
                            <TextBlock Text="Modo padrão" Foreground="{DynamicResource B.TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Avisos -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Notices}" Margin="24,0,24,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Notice}">
                        <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="{DynamicResource R.CornerSmall}" Background="{DynamicResource B.SurfaceAlt}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.Primary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Warning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource B.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Padding="4" ToolTip="Dispensar"
                                        Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}" Width="12" Height="12" />
                                </Button>
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Info}" Margin="0,0,10,0" Stroke="{DynamicResource B.Warning}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" Margin="0,4,0,0">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
