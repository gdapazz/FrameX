<UserControl x:Class="Framex.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Framex.App.ViewModels"
             xmlns:fx="clr-namespace:Framex.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReportsViewModel}" d:DesignWidth="1100" d:DesignHeight="800">
    <UserControl.Resources>
        <fx:BoolToVisibilityConverter x:Key="Vis" />

        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding LoadCommand}" VerticalAlignment="Center" ToolTip="Recarregar">
                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Refresh}" Width="15" Height="15" />
            </Button>
            <StackPanel>
                <TextBlock Text="Relatórios" Style="{StaticResource Text.Hero}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Filtros -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Width="260" Margin="0,0,10,8">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0" ToolTip="Buscar por jogo" />
                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Search}" Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left"
                      IsHitTestVisible="False" Stroke="{DynamicResource B.TextMuted}" />
            </Grid>
            <ComboBox Width="200" Margin="0,0,10,8" ItemsSource="{Binding GameChoices}" SelectedItem="{Binding GameFilter}" DisplayMemberPath="Label" ToolTip="Jogo" />
            <ComboBox Width="170" Margin="0,0,10,8" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" DisplayMemberPath="Label" ToolTip="Período" />
            <ComboBox Width="160" Margin="0,0,10,8" ItemsSource="{Binding MinDurations}" SelectedItem="{Binding MinDuration}" DisplayMemberPath="Label" ToolTip="Duração mínima" />
            <ComboBox Width="170" Margin="0,0,10,8" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" ToolTip="Ordenação" />
            <Button Content="Limpar filtros" Style="{StaticResource Button.Ghost}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" />
        </WrapPanel>

        <!-- Barra de seleção -->
        <Border Grid.Row="2" Style="{StaticResource Card.Inset}" Padding="14,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding CompareSelectedCommand}" Margin="0,0,8,0" ToolTip="Selecione exatamente duas sessões">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Compare}" Width="15" Height="15" />
                            <TextBlock Text="Comparar" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Margin="0,0,8,0" Click="OnExportClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Export}" Width="15" Height="15" />
                            <TextBlock Text="Exportar" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="HTML (relatório offline)" Command="{Binding PlacementTarget.DataContext.ExportSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Html" />
                                <MenuItem Header="CSV (amostras)" Command="{Binding PlacementTarget.DataContext.ExportSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Csv" />
                                <MenuItem Header="JSON (dados completos)" Command="{Binding PlacementTarget.DataContext.ExportSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Json" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Button.Danger}" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Trash}" Width="15" Height="15" />
                            <TextBlock Text="Excluir" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="Limpar seleção" Style="{StaticResource Button.Ghost}" Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Muted}">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" /> <Run Text="selecionada(s) · selecione duas sessões para comparar ou várias para exportar" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="JOGO" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="INÍCIO" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="3" Text="DURAÇÃO" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="4" Text="FPS MÉDIO" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="5" Text="1% LOW" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="6" Text="CPU MÁX" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="7" Text="GPU MÁX" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="8" Text="ESTADO" Style="{StaticResource HeaderText}" />
                </Grid>
                <Rectangle DockPanel.Dock="Top" Style="{StaticResource Divider}" Margin="0" />
                <Grid>
                    <TextBlock Text="Nenhuma sessão. As sessões são gravadas automaticamente quando um jogo é detectado." Style="{StaticResource Text.Muted}" Margin="20"
                               HorizontalAlignment="Center" Visibility="{Binding Sessions.Count, Converter={x:Static fx:CountToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                    <ListBox ItemsSource="{Binding Sessions}" ItemContainerStyle="{StaticResource ListItem.Plain}" BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
                                <Border x:Name="Row" Padding="16,0" Height="46" Background="Transparent" CornerRadius="8" Margin="4,1"
                                        MouseLeftButtonDown="OnRowMouseDown" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip="Selecionar" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Chip}" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding Unconfirmed, Converter={StaticResource Vis}}"
                                                    ToolTip="Jogo detectado automaticamente e ainda não confirmado">
                                                <TextBlock Text="não confirmado" FontSize="10" Foreground="{DynamicResource B.Warning}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Started}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding AverageFps}" VerticalAlignment="Center" FontFamily="{DynamicResource F.Display}" FontSize="15" Foreground="{DynamicResource B.Primary}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Low1}" VerticalAlignment="Center" FontFamily="{DynamicResource F.Display}" FontSize="15" />
                                        <TextBlock Grid.Column="6" Text="{Binding MaxCpuTemp}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="{Binding MaxGpuTemp}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="8" Text="{Binding StateText}" VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Incomplete}" Value="True"><Setter Property="Foreground" Value="{DynamicResource B.Warning}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Foreground" Value="{DynamicResource B.Success}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.Hover}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.PrimarySoft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
