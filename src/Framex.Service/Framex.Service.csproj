<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Framex.Service</RootNamespace>
    <AssemblyName>Framex.Service</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>..\Framex.App\Assets\framex.ico</ApplicationIcon>
    <Title>FRAMEX Service</Title>
    <Description>Serviço do FRAMEX: sensores de CPU (LibreHardwareMonitor + PawnIO) e captura de quadros (PresentMon) para o app sem elevação</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Framex.Core\Framex.Core.csproj" />
    <ProjectReference Include="..\Framex.Infrastructure\Framex.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
